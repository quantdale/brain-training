{
  "expo": {
    "name": "Brain Training",
    "slug": "brain-training",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "scheme": "braintraining",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/app-icon.png",
      "bundleIdentifier": "com.braintraining.app"
    },
    "android": {
      "package": "com.braintraining.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6F7FB",
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
    "expo-router",
    "./plugins/with-android-backup-rules",
    "./plugins/with-android-ndk-pin",
    "./plugins/with-deterministic-version",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7FB",
          "image": "./assets/branding/splash-mark.png",
          "imageWidth": 96,
          "dark": { "backgroundColor": "#0D1728", "image": "./assets/branding/splash-mark.png" }
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Manrope-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Manrope-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Manrope-Bold.ttf", "weight": 700 }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Manrope-Regular.ttf",
              "./assets/fonts/Manrope-SemiBold.ttf",
              "./assets/fonts/Manrope-Bold.ttf"
            ]
          }
        }
      ],
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
