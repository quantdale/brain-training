<RNCSafeAreaProvider
  onInsetsChange={[Function]}
  style={
    [
      {
        "flex": 1,
      },
      undefined,
    ]
  }
>
  <RNCSafeAreaView
    edges={
      {
        "bottom": "additive",
        "left": "additive",
        "right": "additive",
        "top": "additive",
      }
    }
    style={
      {
        "flex": 1,
      }
    }
  >
    <RNCSafeAreaView
      edges={
        {
          "bottom": "off",
          "left": "additive",
          "right": "additive",
          "top": "additive",
        }
      }
      style={
        {
          "flex": 1,
        }
      }
    >
      <RCTScrollView
        contentContainerStyle={
          [
            {
              "flexDirection": "row",
              "flexGrow": 1,
              "justifyContent": "center",
            },
            {
              "paddingBottom": 24,
            },
          ]
        }
        keyboardDismissMode="on-drag"
        keyboardShouldPersistTaps="handled"
        style={
          {
            "flex": 1,
          }
        }
      >
        <View>
          <View
            style={
              [
                {
                  "flexGrow": 1,
                  "gap": 16,
                },
                {
                  "maxWidth": 750,
                  "paddingHorizontal": 20,
                  "paddingTop": 24,
                },
              ]
            }
          >
            <Text
              maxFontSizeMultiplier={1.6}
              style={
                [
                  {
                    "color": "#1A1B2E",
                  },
                  {
                    "fontSize": 30,
                    "fontWeight": "800",
                    "letterSpacing": -0.6,
                    "lineHeight": 36,
                  },
                  false,
                  false,
                  false,
                  false,
                  undefined,
                ]
              }
              testID="profile-title"
            >
              Profile
            </Text>
            <View
              accessibilityLiveRegion="polite"
              style={
                [
                  {
                    "overflow": "hidden",
                  },
                  {
                    "backgroundColor": "#FFFFFF",
                    "borderRadius": 22,
                    "boxShadow": "0 1px 2px rgba(64, 38, 12, 0.05), 0 6px 18px rgba(64, 38, 12, 0.07)",
                    "elevation": 3,
                    "padding": 16,
                  },
                  undefined,
                ]
              }
              testID="profile-error"
            >
              <Text
                maxFontSizeMultiplier={1.6}
                style={
                  [
                    {
                      "color": "#B42318",
                    },
                    {
                      "fontSize": 24,
                      "fontWeight": "800",
                      "letterSpacing": -0.3,
                      "lineHeight": 30,
                    },
                    false,
                    false,
                    false,
                    false,
                    undefined,
                  ]
                }
              >
                Couldn't load your profile
              </Text>
              <Text
                maxFontSizeMultiplier={2}
                style={
                  [
                    {
                      "color": "#5B5E77",
                    },
                    {
                      "fontSize": 14,
                      "fontWeight": "500",
                      "lineHeight": 20,
                    },
                    false,
                    false,
                    false,
                    false,
                    undefined,
                  ]
                }
              >
                Your profile data is unavailable right now.
              </Text>
              <View
                accessibilityLabel="Try again"
                accessibilityRole="button"
                accessibilityState={
                  {
                    "busy": false,
                    "checked": undefined,
                    "disabled": false,
                    "expanded": undefined,
                    "selected": undefined,
                  }
                }
                accessibilityValue={
                  {
                    "max": undefined,
                    "min": undefined,
                    "now": undefined,
                    "text": undefined,
                  }
                }
                accessible={true}
                collapsable={false}
                focusable={true}
                onBlur={[Function]}
                onClick={[Function]}
                onFocus={[Function]}
                onResponderGrant={[Function]}
                onResponderMove={[Function]}
                onResponderRelease={[Function]}
                onResponderTerminate={[Function]}
                onResponderTerminationRequest={[Function]}
                onStartShouldSetResponder={[Function]}
                style={
                  {
                    "alignItems": "center",
                    "backgroundColor": "#FFE7E1",
                    "borderColor": "transparent",
                    "borderRadius": 999,
                    "flexDirection": "row",
                    "gap": 8,
                    "justifyContent": "center",
                    "marginTop": 4,
                    "minHeight": 44,
                    "minWidth": 44,
                    "paddingHorizontal": 16,
                    "transform": [
                      {
                        "scale": 1,
                      },
                    ],
                  }
                }
                testID="profile-error-action"
              >
                <View
                  style={
                    {
                      "alignItems": "center",
                      "flexShrink": 1,
                    }
                  }
                >
                  <Text
                    maxFontSizeMultiplier={2}
                    numberOfLines={2}
                    style={
                      [
                        {
                          "color": "#A62B18",
                        },
                        {
                          "fontSize": 14,
                          "fontWeight": "500",
                          "lineHeight": 20,
                        },
                        false,
                        false,
                        false,
                        false,
                        {
                          "fontFamily": "system-ui",
                          "fontWeight": "500",
                        },
                      ]
                    }
                  >
                    Try again
                  </Text>
                </View>
              </View>
            </View>
          </View>
        </View>
      </RCTScrollView>
    </RNCSafeAreaView>
  </RNCSafeAreaView>
</RNCSafeAreaProvider>
