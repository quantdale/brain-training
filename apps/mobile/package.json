{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --maxWorkers=2",
    "perf:probe": "node ../../scripts/perf/run-probes.mjs",
    "test:coverage": "jest --coverage --testTimeout=90000"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.2",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/jest/setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx",
      "**/__tests__/**/*.spec.ts",
      "**/__tests__/**/*.spec.tsx"
    ],
    "testTimeout": 15000,
    "collectCoverageFrom": [
      "src/{db,data-portability,workout,rating,quests}/**/*.{ts,tsx}",
      "!src/**/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 91,
        "branches": 83,
        "functions": 90,
        "lines": 91
      },
      "./src/db/": {
        "statements": 91,
        "branches": 84,
        "functions": 93,
        "lines": 91
      },
      "./src/data-portability/": {
        "statements": 92,
        "branches": 85,
        "functions": 98,
        "lines": 92
      },
      "./src/workout/": {
        "statements": 91,
        "branches": 87,
        "functions": 94,
        "lines": 91
      },
      "./src/rating/": {
        "statements": 94,
        "branches": 91,
        "functions": 99,
        "lines": 94
      },
      "./src/quests/": {
        "statements": 96,
        "branches": 83,
        "functions": 99,
        "lines": 96
      }
    }
  }
}
